<% if(success &&success.length>0){%>
     <!--  i want to show alert in same size block -->
<div class="alert alert-success col-4 offset-3 " role="alert">
    <%= success %> 
    <!-- the cross btn is showing just after the alert message -->
    <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="close">
    </button>
</div>
<%}%>

<%if (error && error.length>0) {%>
    <div class="alert alert-danger col-4 offset-3" role="alert">
        <%= error %>
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="close">
        </button>
    </div>
<%}%>